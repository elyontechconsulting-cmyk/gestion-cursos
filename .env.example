# Copia este archivo como .env.local y completa los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas aquí secretos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# El token de apisperu.com NO va aquí. Se guarda como secreto de la Edge Function:
#   supabase secrets set APISPERU_TOKEN=tu_token
